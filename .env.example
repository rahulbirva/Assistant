# ==============================================================================
# JARVIS ENVIRONMENT CONFIGURATION & API KEYS
# Copy this file to .env and insert your personal API keys
# ==============================================================================

# Spotify Developer API (https://developer.spotify.com/dashboard)
# 1. Create an app on Spotify Developer Dashboard
# 2. Add Redirect URI: http://localhost:8888/callback
# 3. Copy your Client ID and Client Secret below:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
